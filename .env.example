# MongoDB connection string
# Get this from MongoDB Atlas → Connect → Drivers
# Example (Atlas):  mongodb+srv://username:password@cluster0.abc12.mongodb.net/?retryWrites=true&w=majority
# Example (local):  mongodb://127.0.0.1:27017
MONGODB_URI=mongodb+srv://utkarshojha54321:utkarsh2004@csewhy.atswdge.mongodb.net/?appName=CSEWhy
# Database and collection names (defaults shown — change if needed)
DB_NAME=upsc_quiz
COL_NAME=leaderboard

# Server port (default: 3001)
PORT=3001
